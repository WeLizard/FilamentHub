# Database
# Для локальной разработки используйте localhost
# Docker Compose автоматически переопределит на правильные имена сервисов
DATABASE_URL=postgresql+asyncpg://filamenthub:your_password@localhost:5432/filamenthub
DATABASE_ECHO=False  # Set to True for SQL query logging
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis
# Для локальной разработки используйте localhost
# Docker Compose автоматически переопределит на правильные имена сервисов
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 часа — не банк, удобство важнее
REFRESH_TOKEN_EXPIRE_DAYS=90  # 90 дней для refresh token

# Request-scoped OAuth region policy. Missing/unreadable GeoIP data fails closed.
AUTH_REGION_MODE=geoip
GEOIP_COUNTRY_DB_PATH=/app/data/geoip/dbip-country-lite.mmdb
AUTH_CLIENT_IP_HEADER=X-FilamentHub-Client-IP
AUTH_TRUSTED_PROXY_NETWORKS=172.30.0.10/32
# Legal/operational switch for INTL Google OAuth and Google reCAPTCHA.
# Changing it requires a backend restart. Keep false until the flow may run.
INTL_GOOGLE_SERVICES_ENABLED=false

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=FilamentHub
VERSION=0.1.0
DEBUG=True

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# Email: Russian SMTP relay plus a local receiving mail server
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
EMAIL_FROM=noreply@filamenthub.ru
EMAIL_FROM_NAME=FilamentHub
EMAIL_CONTACT=support@filamenthub.ru
EMAIL_PARTNERSHIPS_FROM=partners@filamenthub.ru
EMAIL_PR_FROM=pr@filamenthub.ru
# Receiving domain handled by the local mail server, without @
EMAIL_INBOUND_DOMAIN=
INBOUND_MAIL_DIR=/app/inbound_mail
INBOUND_MAIL_POLL_SECONDS=30

# File Upload
MAX_UPLOAD_SIZE_MB=50

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
