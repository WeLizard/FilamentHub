# Multi-stage build for production
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# reCAPTCHA v3 site key (публичный, передаётся через docker-compose build args)
ARG VITE_RECAPTCHA_SITE_KEY=""
ENV VITE_RECAPTCHA_SITE_KEY=${VITE_RECAPTCHA_SITE_KEY}

# Auth mode: jwt | cookie | dual (см. frontend/src/utils/auth.ts)
# Должен совпадать с backend AUTH_WEB_MODE для cookie-режима
ARG VITE_AUTH_WEB_MODE=""
ENV VITE_AUTH_WEB_MODE=${VITE_AUTH_WEB_MODE}
ARG VITE_AUTH_CSRF_HEADER_NAME=""
ENV VITE_AUTH_CSRF_HEADER_NAME=${VITE_AUTH_CSRF_HEADER_NAME}
ARG VITE_AUTH_CSRF_COOKIE_NAME=""
ENV VITE_AUTH_CSRF_COOKIE_NAME=${VITE_AUTH_CSRF_COOKIE_NAME}

# Build for production
RUN npm run build

# Production stage
FROM nginx:1.31.2-alpine@sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# COPY carries the modes of the build context, and nginx serves as its own user: a
# checkout made under a restrictive umask produced asset files it could not read, and
# the site answered 403 for two icons while everything drawn inline kept working.
# Normalising here makes the image independent of whatever the working copy looked like.
RUN chmod -R a+rX /usr/share/nginx/html

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY cloudflare-real-ip.conf /etc/nginx/snippets/cloudflare-real-ip.conf
COPY site-common.conf /etc/nginx/snippets/filamenthub-site.conf

# Expose port 80
EXPOSE 80

# Alpine resolves localhost to ::1 first, while this nginx config listens on IPv4.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget --no-check-certificate --header='Host: filamenthub.ru' -qO /dev/null https://127.0.0.1/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]


