<div class="fhb-spool-picker" data-bind="attr: { 'aria-busy': busy() ? 'true' : 'false' }">
  <div class="fhb-picker-heading">
    <div>
      <strong>{{ _('Desired spool for') }} <span data-bind="text: editingSlot() ? slotIdentity(editingSlot()) : ''"></span></strong>
      <small>{{ _('Saved in FilamentHub only. Install the physical spool yourself; hardware state is not changed.') }}</small>
    </div>
    <button type="button" class="close" aria-label="{{ _('Close') }}" data-bind="click: cancelSpoolPicker, disable: busy">×</button>
  </div>
  <form class="fhb-picker-search" data-bind="submit: function () { searchSpools(true); }">
    <input type="search" class="input-block-level" aria-label="{{ _('Search spools') }}" placeholder="{{ _('Search by material, color, brand or spool ID') }}" data-bind="textInput: spoolQuery, disable: busy, event: { keydown: onSpoolSearchKeydown }">
    <button type="submit" class="btn" data-bind="disable: busy">{{ _('Search') }}</button>
  </form>
  <select class="input-block-level" aria-label="{{ _('Choose a spool') }}" data-bind="
      options: spoolOptions,
      optionsText: spoolOptionText,
      optionsValue: 'id',
      optionsCaption: &quot;{{ _('Choose a spool') }}&quot;,
      value: selectedSpoolId,
      disable: busy"></select>
  <small class="fhb-picker-empty" role="status" data-bind="visible: busy">{{ _('Working…') }}</small>
  <small class="fhb-picker-empty" data-bind="visible: !busy() && !lastError() && spoolOptions().length === 0">{{ _('No matching usable spools.') }}</small>
  <div class="alert alert-error fhb-picker-warning" role="alert" data-bind="visible: lastError, text: lastError"></div>
  <div class="alert alert-warning fhb-picker-warning" data-bind="visible: selectedSpoolLocationText, text: selectedSpoolLocationText"></div>
  <div class="fhb-picker-actions">
    <button type="button" class="btn btn-primary" data-bind="click: assignSelectedSpool, disable: busy() || !selectedSpoolId()">{{ _('Assign spool') }}</button>
    <button type="button" class="btn" data-bind="visible: editingSlot() && editingSlot().spool, click: clearSpoolAssignment, disable: busy">{{ _('Remove spool') }}</button>
    <button type="button" class="btn btn-link" data-bind="click: cancelSpoolPicker, disable: busy">{{ _('Cancel') }}</button>
    <button type="button" class="btn btn-link fhb-load-more" data-bind="visible: nextSpoolOffset() !== null, click: function () { searchSpools(false); }, disable: busy">{{ _('Load more') }}</button>
  </div>
</div>
